# 复制为 .env；环境变量优先于文件。不要提交真实密钥。
# AI 配置每次考试批次开始时重读；浏览器、节奏、路径和日志文件配置需重启。

# AI 为可选功能。以下为兼容服务示例，模型/接口能力须由服务商支持。
OPENAI_COMPLETION_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
OPENAI_COMPLETION_API_KEY=your_api_key_here
MODEL_NAME=qwen3.6-plus
AI_PROVIDER=compatible
AI_REQUEST_TYPE=responses

# provider：openai / compatible。协议：chat / responses。
# prompt_json：提示词要求 JSON，本地严格校验；json_schema：接口还需支持严格结构化输出。
AI_OUTPUT_MODE=prompt_json

# 联网搜索默认关闭。openai 仅 responses 支持；compatible/chat 发送 enable_search。
# responses 使用 web_search 工具，服务商必须支持该工具。
AI_ENABLE_WEB_SEARCH=0

# compatible 可发送 enable_thinking；标准 openai 使用 AI_REASONING_EFFORT。
# 设置 reasoning_effort 后不再发送 enable_thinking。
AI_ENABLE_THINKING=0
# AI_REASONING_EFFORT=medium
# 合法值：none / minimal / low / medium / high / xhigh；仍需模型支持。
# AI_TEMPERATURE=0
# 温度可选，范围 0–2；留空不发送，不假定推理模型支持温度。

# 单次 HTTP 读写超时、每题所有尝试总期限（秒，1–3600）。总期限包含退避。
AI_REQUEST_TIMEOUT=60
AI_TOTAL_TIMEOUT=180
# 业务重试 0–5 次；SDK 内置重试固定关闭，默认最多 3 次请求。
AI_MAX_RETRIES=2

# 浏览器正式流程始终可见。类型 chromium / firefox / webkit。
# Windows 的 chromium 未配置 channel 时使用 Edge；显式空值使用 Playwright Chromium。
# BROWSER_TYPE=chromium
# BROWSER_CHANNEL=msedge
# BROWSER_CHANNEL=""
# firefox / webkit 请留空 channel，并先安装对应 Playwright 浏览器。

# 默认数据目录为项目根目录/data；建议使用绝对路径。相同目录仅允许运行一个正式实例。
# COURSE_AFK_DATA_DIR=C:/course-afk-data

# 节奏区间；最小值不应高于最大值，均不得为负。
# 浏览器动作间隔，毫秒，每次启动取一次。
# AFK_SLOW_MO_MIN=1500
# AFK_SLOW_MO_MAX=4500
# 视频核对间隔与额外余量，秒。
# VIDEO_WATCH_SLICE_MIN=20
# VIDEO_WATCH_SLICE_MAX=55
# VIDEO_WATCH_OVERSHOOT_MIN=5
# VIDEO_WATCH_OVERSHOOT_MAX=45
# VIDEO_STALL_MAX_EXTRA_WAIT=300
# 章节、课程间停顿，秒。
# SECTION_GAP_MIN=2
# SECTION_GAP_MAX=7
# COURSE_GAP_MIN=8
# COURSE_GAP_MAX=40
# 考试选项及交卷确认步骤之间的停顿，秒。
# EXAM_OPTION_GAP_MIN=0.25
# EXAM_OPTION_GAP_MAX=0.9
# EXAM_SUBMIT_GAP_MIN=0.8
# EXAM_SUBMIT_GAP_MAX=2.5

# 控制台 DEBUG 与启动横幅开关，0/1；默认均为 0。
# DEBUG_MODE=1
# SUPPRESS_STARTUP_BANNER=1
